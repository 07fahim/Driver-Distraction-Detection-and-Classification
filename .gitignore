# SafeDrive AI - .gitignore

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/

# --- Virtual Environment ---
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# --- Jupyter Notebooks ---
.ipynb_checkpoints/

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- System files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & Caches ---
*.log
*.out
*.tmp
*.cache
logs/

# --- Flask ---
instance/
.webassets-cache
.pytest_cache/

# --- Gradio & Hugging Face Spaces ---
*.gradio
.gradio/
.gradio_cache/
gradio_cache/
outputs/
runs/
uploads/
temp/
tmp/

# --- Dataset ---
data/
datasets/
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# --- Uploaded Files (Temporary) ---
static/uploads/
static/temp/
uploaded_images/
uploaded_videos/
processed_videos/

# --- Environment & Config ---
.env
.env.*
.env.local
.env.production
config.json
secrets.json


# --- Testing ---
.coverage
htmlcov/
.tox/
.pytest_cache/
nosetests.xml
coverage.xml
*.cover

# --- Documentation Build ---
docs/_build/
site/

# --- Others ---
*.bak
*.old
*.orig
.sass-cache/
node_modules/
package-lock.json

# --- Keep these files ---
!.gitkeep
!requirements.txt
!README.md